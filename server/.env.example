NODE_ENV=development
PORT=4000

# Where the Next.js frontend runs. Reset links point here.
APP_URL=http://localhost:3000

# Comma-separated CORS allowlist. Must include APP_URL.
CORS_ORIGINS=http://localhost:3000

# PostgreSQL. Replace YOUR_LOCAL_USERNAME with your local database role.
DATABASE_URL="postgresql://YOUR_LOCAL_USERNAME@127.0.0.1:5432/bowline_global_trading"
# Set this when DATABASE_URL goes through a transaction pooler. Prisma Migrate
# and the seed use the direct connection, with DATABASE_URL as a fallback.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/bowline_global_trading"

# Auth
# Generate each with: openssl rand -base64 48
# These MUST be different from each other.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Cookie domain for the refresh token. Leave blank for localhost.
# COOKIE_DOMAIN=

# Supabase Storage (optional locally). Use a Bowline project for uploads.
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=proofs

# Email (Resend)
# RESEND_API_KEY=
EMAIL_FROM="Bowline Global Trading <noreply@example.com>"
# Where "contact support" replies go
SUPPORT_EMAIL=support@example.com

# Bearer secret for the internal job endpoint an external scheduler calls
# (POST /api/v1/internal/jobs/accrue-plan-returns). Leave unset to disable it.
# Generate with: openssl rand -base64 48
# CRON_SECRET=

# Optional admin for `npm run seed`. Use a password of at least 12 characters.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=

# Business rules
WITHDRAWAL_FEE_PERCENT=5
MIN_WITHDRAWAL_USD=10
MIN_DEPOSIT_USD=250
